# Tak_OS · home/hypr-desktop.nix — Declarative Hyprland user config
# github.com/tak0dan/Tak_OS · GNU GPLv3
{ config, lib, features, ... }:

let
  user = config.home.username;
  lockSecs = features.hypr.lock.timeout;
  warnSecs = lib.max 0 (lockSecs - 60);
  defaultTheme = features.hypr.logoutTheme;
  overrides = features.hypr.userLogoutThemes or { };
  profile = overrides.${user} or defaultTheme;
  themeDir = builtins.path {
    name = "wlogout-theme-${profile}";
    path = /etc/nixos/assets/wlogout + "/${profile}";
  };
in
{
  xdg.configFile."hypr/hypridle.conf" = lib.mkIf (features.hyprland && features.hypr.idle) {
    force = true;
    text = ''
      # Generated by Tak_OS · home/hypr-desktop.nix
      # Edit features.hypr.lock / features.hypr.idle in /etc/nixos/configuration.nix.

      $iDIR="$HOME/.config/swaync/images/ja.png"

      general {
        ${lib.optionalString features.hypr.lock.enable
          "lock_cmd            = pidof hyprlock || hyprlock"}
        before_sleep_cmd    = loginctl lock-session
        after_sleep_cmd     = hyprctl dispatch dpms on
        ignore_dbus_inhibit = false
      }

      listener {
        timeout    = ${toString warnSecs}
        on-timeout = notify-send -i $iDIR " You are idle!"
        on-resume  = notify-send -i $iDIR " Oh! you're Back" " Hello !!!"
      }

      ${lib.optionalString features.hypr.lock.enable ''
      listener {
        timeout    = ${toString lockSecs}
        on-timeout = loginctl lock-session
      }
      ''}
    '';
  };

  xdg.configFile."wlogout" = lib.mkIf (features.hyprland && features.hypr.logout) {
    source = themeDir;
    recursive = true;
  };
}
